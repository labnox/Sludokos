{
  "name": "Remix Sludoko - Sudoku PWA",
  "short_name": "Sludoko",
  "description": "Een interactieve, moderne en mobielvriendelijke Sudoku Progressive Web App (PWA) met offline ondersteuning, notities, hints en statistieken.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#0f172a",
  "theme_color": "#6366f1",
  "orientation": "portrait-primary",
  "lang": "nl",
  "categories": ["games", "puzzle"],
  "icons": [
    {
      "src": "icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Nieuw Spel (Gemiddeld)",
      "short_name": "Nieuw Spel",
      "description": "Start direct een nieuwe Sudoku puzzel op gemiddeld niveau",
      "url": "./index.html?diff=MEDIUM",
      "icons": [{ "src": "icons/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Bekijk Statistieken",
      "short_name": "Statistieken",
      "description": "Bekijk je Sudoku statistieken en beste tijden",
      "url": "./index.html?view=stats",
      "icons": [{ "src": "icons/icon-192.svg", "sizes": "192x192" }]
    }
  ]
}
